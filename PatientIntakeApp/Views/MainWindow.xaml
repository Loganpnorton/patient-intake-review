<Window x:Class="PatientIntakeApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PatientIntakeApp.ViewModels"
        xmlns:v="clr-namespace:PatientIntakeApp.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:PatientIntakeApp.Converters"
        mc:Ignorable="d"
        Title="Patient Intake Analysis" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Focusable="True">
    
    <Window.Resources>
        <converters:OnlineDotBrushConverter x:Key="OnlineDotBrushConverter"/>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DialogViewModel}">
            <Grid>
                <materialDesign:Card Padding="0" UniformCornerRadius="12" MaxWidth="520">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                 Kind="{Binding IconKind}"
                                                 Width="36" Height="36"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Top"
                                                 Margin="0,2,16,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Title}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Message}"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MaterialDesignBody}"/>

                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">
                            <!-- OK -->
                            <Button Content="{Binding OkText}"
                                    Style="{StaticResource NoRippleRaisedButton}"
                                    Command="{Binding OkCommand}"
                                    Visibility="{Binding Buttons, Converter={StaticResource EnumToVis}, ConverterParameter=Ok}"
                                    MinWidth="90"
                                    Height="36"/>

                            <!-- Yes/No -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding Buttons, Converter={StaticResource EnumToVis}, ConverterParameter=YesNo}">
                                <Button Content="{Binding NoText}"
                                        Style="{StaticResource NoRippleOutlinedButton}"
                                        Command="{Binding NoCommand}"
                                        MinWidth="90"
                                        Height="36"
                                        Margin="0,0,10,0"/>
                                <Button Content="{Binding YesText}"
                                        Style="{StaticResource NoRippleRaisedButton}"
                                        Command="{Binding YesCommand}"
                                        MinWidth="90"
                                        Height="36"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TransferUserDialogViewModel}">
            <Grid>
                <materialDesign:Card Padding="0"
                                     UniformCornerRadius="12"
                                     Width="760"
                                     MinHeight="520">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Title}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,16"/>

                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search users"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 MinHeight="44"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,16"/>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding UsersView}"
                                 SelectedItem="{Binding SelectedUser}"
                                 BorderThickness="0"
                                 MinHeight="320"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,0,0,10" CornerRadius="10" BorderThickness="1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding IsOnline, Converter={StaticResource OnlineDotBrushConverter}}"
                                                     Margin="0,0,14,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Username}" FontSize="11"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="TRANSFER"
                                                    Command="{Binding DataContext.SelectAndTransferCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NoRippleRaisedButton}"
                                                    Height="36"
                                                    MinWidth="110"
                                                    Padding="16,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="CLOSE"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource NoRippleOutlinedButton}"
                                    MinWidth="90"
                                    Height="36"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DuplicateReferralsViewModel}">
            <Grid>
                <materialDesign:Card Padding="0"
                                     UniformCornerRadius="12"
                                     Width="1020"
                                     MinHeight="560">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="CLOSE"
                                    Command="{Binding CloseCommand}"
                                    Style="{StaticResource NoRippleOutlinedButton}"
                                    Height="36"
                                    Padding="14,0"/>
                        </Grid>

                        <materialDesign:Card Grid.Row="1" Padding="12" UniformCornerRadius="10">
                            <DataGrid ItemsSource="{Binding Duplicates}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ingested" Binding="{Binding IngestedAt, Converter={StaticResource UtcToLocalDateTimeString}}" Width="170"/>
                                    <DataGridTextColumn Header="Facility" Binding="{Binding Facility.Name}" Width="200"/>
                                    <DataGridTextColumn Header="File" Binding="{Binding SourceFileName}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                                    <DataGridTemplateColumn Header="Action" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="OPEN"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleRaisedButton}"
                                                        Height="34"
                                                        MinWidth="120"
                                                        Padding="16,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>

                        <TextBlock Grid.Row="2"
                                   Text="Tip: duplicates are detected by file hash (exact) and/or patient identifiers (if provided)."
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="4,12,4,0"/>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IngestionViewModel}">
            <v:IngestionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessingViewModel}">
            <v:ProcessingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
            <v:ReviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinalReportViewModel}">
            <v:FinalReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AllClearViewModel}">
            <v:AllClearView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent User Actions Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="12"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Facility selector (staging queue only).
                     IMPORTANT: Use an explicit ContentTemplate so we don't accidentally render other views here
                     via implicit DataTemplates (which caused ReviewView to appear twice). -->
                <ContentControl Grid.Column="0"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsIngestionActive, Converter={StaticResource BoolToVis}}"
                                Content="{Binding CurrentViewModel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="HospitalBuilding"
                                                         Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding Facilities}"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedFacilityId}"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Name"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Height="36"
                                          Padding="10,4"
                                          HorizontalAlignment="Stretch"
                                          materialDesign:HintAssist.Hint="Facility"/>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- User actions pinned right -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding UsernameDisplay}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource MaterialDesignBody}"/>

                    <Button Style="{StaticResource FlatIconButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings"
                            Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"/>
                    </Button>

                    <Button Style="{StaticResource FlatIconButton}"
                            Command="{Binding LogoutCommand}"
                            ToolTip="Logout">
                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

        <!-- Settings Overlay -->
        <Border Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="900">
            <Grid>
                <ContentControl Content="{Binding Settings}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="24"/>
            </Grid>
        </Border>

        <!-- Dialog Overlay -->
        <Border Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsDialogVisible, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="2000">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <ContentControl Content="{Binding ActiveDialog}"/>
            </Grid>
        </Border>

        <!-- Toast / Snackbar -->
        <materialDesign:Snackbar Grid.RowSpan="2"
                                 Panel.ZIndex="1500"
                                 MessageQueue="{Binding ToastQueue}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="24"/>

        <!-- Dev Settings Overlay (deprecated): migrated to Settings -> Developer Options -->
    </Grid>
</Window>
