<UserControl x:Class="PatientIntakeApp.Views.AllClearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <materialDesign:Card Width="450" UniformCornerRadius="8" VerticalAlignment="Center" Padding="32">
            <StackPanel HorizontalAlignment="Center">
                
                <materialDesign:PackIcon Kind="CheckCircle" 
                                         Width="96" 
                                         Height="96" 
                                         Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                         HorizontalAlignment="Center" 
                                         Margin="0,0,0,32"/>
                
                <TextBlock Text="No Disqualifying Criteria Found" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,32"/>
                
                <Button Content="NEXT PATIENT" 
                        Command="{Binding NextPatientCommand}" 
                        Style="{StaticResource NoRippleRaisedButton}"
                        Width="200"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
