<UserControl x:Class="PatientIntakeApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:PatientIntakeApp.Converters"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:NullableGuidToYesNoConverter x:Key="NullableGuidToYesNoConverter"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Referral Dashboard"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                <TextBlock Text="Shared queue"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="38"
                          MinWidth="160"
                          Padding="10,4"
                          Margin="0,0,10,0"
                          materialDesign:HintAssist.Hint="Status"/>
                <Button Content="NEW REFERRAL"
                        Command="{Binding NewReferralCommand}"
                        Style="{StaticResource NoRippleRaisedButton}"
                        Height="38"
                        Margin="0,0,10,0"/>
                <Button Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource NoRippleOutlinedButton}"
                        Height="38"/>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1"
                     Height="4"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="#D32F2F"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVis}}"
                           Margin="0,0,0,10"/>

                <TabControl Grid.Row="1">
                    <TabItem Header="Unassigned">
                        <DataGrid ItemsSource="{Binding Unassigned}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ingested" Binding="{Binding IngestedAt, Converter={StaticResource UtcToLocalDateTimeString}}" Width="160"/>
                                <DataGridTextColumn Header="Facility" Binding="{Binding Facility.Name}" Width="200"/>
                                <DataGridTextColumn Header="File" Binding="{Binding SourceFileName}" Width="*"/>
                                <DataGridTextColumn Header="Dup" Binding="{Binding DuplicateOfReferralId, Converter={StaticResource NullableGuidToYesNoConverter}}" Width="60"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                <DataGridTemplateColumn Header="Actions" Width="330">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="OPEN"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Height="28"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="ASSIGN TO ME"
                                                        Command="{Binding DataContext.AssignToMeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleRaisedButton}"
                                                        Height="28"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="DELETE"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Foreground="#D32F2F"
                                                        Height="28"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="My Assigned">
                        <DataGrid ItemsSource="{Binding MyAssigned}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ingested" Binding="{Binding IngestedAt, Converter={StaticResource UtcToLocalDateTimeString}}" Width="160"/>
                                <DataGridTextColumn Header="Facility" Binding="{Binding Facility.Name}" Width="200"/>
                                <DataGridTextColumn Header="File" Binding="{Binding SourceFileName}" Width="*"/>
                                <DataGridTextColumn Header="Dup" Binding="{Binding DuplicateOfReferralId, Converter={StaticResource NullableGuidToYesNoConverter}}" Width="60"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                <DataGridTemplateColumn Header="Actions" Width="500">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="OPEN"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Height="28"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="CHECKS"
                                                        Command="{Binding DataContext.RunPreChecksCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Height="28"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="TRANSFER"
                                                        Command="{Binding DataContext.TransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Height="28"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="UNASSIGN"
                                                        Command="{Binding DataContext.UnassignCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Height="28"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="DELETE"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NoRippleOutlinedButton}"
                                                        Foreground="#D32F2F"
                                                        Height="28"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>

