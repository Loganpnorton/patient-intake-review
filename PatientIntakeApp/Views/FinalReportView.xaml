<UserControl x:Class="PatientIntakeApp.Views.FinalReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:PatientIntakeApp.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:ReviewStatusToChipTextConverter x:Key="ReviewStatusToChipTextConverter"/>
        <converters:FirstLineFromMultilineTextConverter x:Key="FirstLineFromMultilineTextConverter"/>
        <converters:RemainderLinesFromMultilineTextConverter x:Key="RemainderLinesFromMultilineTextConverter"/>
        <converters:HasRemainderLinesToVisibilityConverter x:Key="HasRemainderLinesToVisibilityConverter"/>
        <converters:NormalizeQuotedTextConverter x:Key="NormalizeQuotedTextConverter"/>
        <converters:PairedSingleQuotesToDoubleQuotesConverter x:Key="PairedSingleQuotesToDoubleQuotesConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                    <TextBlock Text="{Binding GeneratedAtDisplay, StringFormat='Generated {0}'}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="BACK TO DASHBOARD"
                        Command="{Binding BackToDashboardCommand}"
                        Style="{StaticResource NoRippleOutlinedButton}"
                        Height="40"
                        Padding="14,0"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- Summary counts -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="14" UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Total Findings" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalFindings, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="14" UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Local" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LocalCount, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="4" Padding="14" UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="AI" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AiCount, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="6" Padding="14" UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Cleared / Flagged" FontWeight="Bold"/>
                        <TextBlock FontSize="20"
                                   FontWeight="Black"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding ClearedCount, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding FlaggedCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- AI Narrative (editable) -->
            <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="8" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="AI Narrative" FontWeight="Bold"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="GENERATE"
                                    Command="{Binding GenerateNarrativeCommand}"
                                    Style="{StaticResource NoRippleOutlinedButton}"
                                    Height="30"
                                    Padding="10,0"
                                    Margin="0,0,10,0"
                                    IsEnabled="{Binding IsGeneratingNarrative, Converter={StaticResource InverseBooleanConverter}}"
                                    Visibility="{Binding AgentOverview, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=Inverse}"/>
                            <Button Style="{StaticResource FlatIconButton}"
                                    Command="{Binding StartEditingOverviewCommand}"
                                    ToolTip="Edit"
                                    Visibility="{Binding IsEditingOverview, Converter={StaticResource InverseBoolToVis}}">
                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                            </Button>

                            <Button Style="{StaticResource FlatIconButton}"
                                    Command="{Binding SaveEditedOverviewCommand}"
                                    ToolTip="Save"
                                    Visibility="{Binding IsEditingOverview, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#388E3C"/>
                            </Button>

                            <Button Style="{StaticResource FlatIconButton}"
                                    Command="{Binding CancelEditingOverviewCommand}"
                                    ToolTip="Cancel"
                                    Visibility="{Binding IsEditingOverview, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#D32F2F"/>
                            </Button>

                            <Button Style="{StaticResource FlatIconButton}"
                                    Command="{Binding CopyOverviewCommand}"
                                    ToolTip="Copy to clipboard">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="No AI narrative was generated for this review."
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontStyle="Italic"
                               Visibility="{Binding AgentOverview, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=Inverse}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding AgentOverview}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsEditingOverview, Converter={StaticResource InverseBoolToVis}}"/>

                    <TextBox Text="{Binding EditedOverview, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="120"
                             Visibility="{Binding IsEditingOverview, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- SME notes -->
            <materialDesign:Card Grid.Row="3" Padding="16" UniformCornerRadius="8" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="SME Consultation Notes" FontWeight="Bold"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource FlatIconButton}"
                                Command="{Binding CopySmeNotesCommand}"
                                ToolTip="Copy to clipboard">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBox Text="{Binding SmeNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="90"
                             materialDesign:HintAssist.Hint="Notes (persisted)"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Context rule checks -->
            <materialDesign:Card Grid.Row="4" Padding="16" UniformCornerRadius="8" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Context Rule Checks"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               FontWeight="Black"/>

                    <TextBlock Text="✓ No context rule violations detected"
                               Foreground="#388E3C"
                               FontWeight="Bold"
                               Visibility="{Binding HasContextViolations, Converter={StaticResource InverseBoolToVis}}"/>

                    <StackPanel Visibility="{Binding HasContextViolations, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ContextViolationCount, Mode=OneWay, StringFormat='Violations detected: {0}'}"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding ContextViolations}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="14" Margin="0,0,0,8" Background="#FFF3E8FF">
                                        <StackPanel>
                                            <!-- Rule text: bold, slightly larger, dark legible color -->
                                            <TextBlock FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#2D1B4E"
                                                       TextWrapping="Wrap">
                                                <Run Text="Rule: "/>
                                                <Run Text="{Binding Term, Converter={StaticResource NormalizeQuotedTextConverter}}"/>
                                            </TextBlock>

                                            <!-- Cited text + page: italic, smaller, medium-gray for clear hierarchy -->
                                            <TextBlock Margin="0,8,0,0"
                                                       FontStyle="Italic"
                                                       FontSize="12"
                                                       Foreground="#5C4F6B"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Context, Converter={StaticResource StringNullOrEmptyToVis}}">
                                                <Run Text="AI cited text: "/>
                                                <Run Text="{Binding Context, Converter={StaticResource FirstLineFromMultilineTextConverter}}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Page, StringFormat='Page {0}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Findings list -->
            <materialDesign:Card Grid.Row="5" Padding="0" UniformCornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Findings" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    </Border>

                    <!-- Use ItemsControl (no inner ScrollViewer) so mouse-wheel scroll always scrolls the page -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="Black" TextWrapping="Wrap">
                                                <Run Text="Term: "/>
                                                <Run Text="{Binding Term, Converter={StaticResource NormalizeQuotedTextConverter}}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Page, StringFormat='Page {0}'}"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Category}"
                                                       FontStyle="Italic"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       Margin="0,2,0,0"/>
                                            <!-- AI evidence / reason (first line of context) -->
                                            <TextBlock Margin="0,6,0,0"
                                                       FontStyle="Italic"
                                                       FontSize="12"
                                                       Foreground="#5C4F6B"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Context, Converter={StaticResource StringNullOrEmptyToVis}}">
                                                <Run Text="AI cited text: "/>
                                                <Run Text="{Binding Context, Converter={StaticResource FirstLineFromMultilineTextConverter}}"/>
                                            </TextBlock>
                                            <!-- Remaining context lines -->
                                            <TextBlock Text="{Binding Context, Converter={StaticResource RemainderLinesFromMultilineTextConverter}}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MaterialDesignBody}"
                                                       Visibility="{Binding Context, Converter={StaticResource HasRemainderLinesToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <materialDesign:Chip Content="{Binding ReviewStatus, Converter={StaticResource ReviewStatusToChipTextConverter}}"
                                                                 Margin="0,0,0,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>

