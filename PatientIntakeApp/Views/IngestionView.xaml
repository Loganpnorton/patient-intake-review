<UserControl x:Class="PatientIntakeApp.Views.IngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Staging Area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/> <!-- Staging List Side Panel -->
            </Grid.ColumnDefinitions>

            <!-- Drag Drop Zone -->
            <materialDesign:Card Grid.Column="0" Margin="24" UniformCornerRadius="12" AllowDrop="True" Drop="OnDrop" 
                                 DragEnter="OnDragEnter" DragLeave="OnDragLeave">
                <materialDesign:Card.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding BrowseFilesCommand}"/>
                </materialDesign:Card.InputBindings>
                
                <Border x:Name="DragBorder" 
                        BorderThickness="2" 
                        CornerRadius="12" 
                        Padding="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDraggingOver}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                                    <Setter Property="Background" Value="#10000000"/> <!-- Slight gray overlay -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource PrimaryHueMidColor}" Opacity="0.1" BlurRadius="20" ShadowDepth="0"/>
                    </Border.Effect>
                    
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CloudUpload" 
                                                 Width="80" 
                                                 Height="80" 
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                 HorizontalAlignment="Center" 
                                                 Margin="0,0,0,24"/>
                        
                        <TextBlock Text="Drag and Drop Patient PDF File Here" 
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                                   
                        <TextBlock Text="Or Click to Browse (PDF Only)" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- Staging Queue -->
            <materialDesign:Card Grid.Column="1" Margin="0,24,24,24" Width="320" UniformCornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Staging Queue"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="DASHBOARD"
                                Command="{Binding ReturnToDashboardCommand}"
                                Style="{StaticResource NoRippleOutlinedButton}"
                                Height="30"
                                Padding="10,0"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding StagedFiles}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0} Pages'}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="2" 
                                            Style="{StaticResource FlatIconButton}" 
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove File"
                                            Width="24" Height="24">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Patient identifiers (improves duplicate detection) -->
                    <StackPanel Grid.Row="2" Margin="16,0,16,0">
                        <TextBlock Text="Patient identifiers (optional)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PatientFirstName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="First name"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     MinHeight="40"
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding PatientLastName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Last name"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     MinHeight="40"
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding PatientDob}"
                                        Margin="0,0,0,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding ExternalMrn, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="MRN (if known)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     MinHeight="40"
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Batching banner (only when staging PDF exceeds page limit) -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="16,6,16,0"
                                Visibility="{Binding IsBatchingOverLimit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Batching Enabled - PDF over page limit."
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource FlatIconButton}"
                                Command="{Binding ShowBatchingInfoCommand}"
                                ToolTip="What is batching?"
                                Width="26"
                                Height="26"
                                Margin="6,0,0,0">
                            <materialDesign:PackIcon Kind="HelpCircleOutline"
                                                     Width="16"
                                                     Height="16"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="4" 
                            Content="START ANALYSIS" 
                            Command="{Binding StartAnalysisCommand}" 
                            Style="{StaticResource NoRippleRaisedButton}"
                            Margin="16"
                            Height="45"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Recent History Footer (developer toggle) -->
        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="16"
                Visibility="{Binding DataContext.DevSettings.ShowRecentlyReviewed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Recently Reviewed" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding RecentHistory}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Chip Content="{Binding FileName}" 
                                                 IconBackground="{DynamicResource PrimaryHueMidBrush}" 
                                                 IconForeground="White"
                                                 Command="{Binding DataContext.ShowRecentHistoryInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 ToolTip="Reports are now in-app only"
                                                 Margin="0,0,8,0">
                                <materialDesign:Chip.Icon>
                                    <materialDesign:PackIcon Kind="FileDocument"/>
                                </materialDesign:Chip.Icon>
                            </materialDesign:Chip>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
