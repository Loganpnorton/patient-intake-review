<UserControl x:Class="PatientIntakeApp.Views.DevSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="400">
    <materialDesign:Card UniformCornerRadius="8" Margin="16" Padding="16"
                         Background="{DynamicResource MaterialDesignPaper}"
                         BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                         BorderThickness="2">
        <StackPanel>
            <TextBlock Text="Developer Settings"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ToggleButton IsChecked="{Binding DisableLocalKeywordSearch}"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              Margin="0,0,8,0"/>
                <TextBlock Text="Disable Local Keyword Search"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ToggleButton IsChecked="{Binding AlwaysForwardToAI}"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              Margin="0,0,8,0"/>
                <TextBlock Text="Always Forward to AI"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="(Overrides local keyword search)"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Ctrl+Shift+D to hide"
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"/>
        </StackPanel>
    </materialDesign:Card>
</UserControl>